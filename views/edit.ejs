<%- include('partials/header.ejs'); %>
<div class="content">
    <h1>Edit Review</h1>
    <form class="review-form" action="/edit/<%= book.id %>" method="POST">
        <div class="form-field">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" value="<%= book.title %>" required>
        </div>
        <div class="form-field">
            <label for="image">Cover — <a href="https://openlibrary.org/" target="_blank">Open Library ID</a></label>
            <input type="text" id="image" name="image" value="<%= book.image %>"required>
        </div>
        <div class="form-field">
            <label for="attribution">Attribution</label>
            <input type="text" id="attribution" name="attribution" value="<%= book.attribution %>" required>
        </div>
        <div class="form-field">
            <label for="review">Rating (1–5)</label>
            <input type="number" id="review" name="review" min="1" max="5" value="<%= book.review %>" required>
        </div>
        <div class="form-field full-width">
            <label for="notes">Notes</label>
            <textarea id="notes" name="notes" required><%= book.notes %></textarea>
        </div>
        <button type="submit">Submit</button>
    </form>
</div>

<%- include('partials/footer.ejs'); %>